# ─── Supabase ─────────────────────────────────────────────────────────────
# The SAME project the desktop app uses — same auth.users, same entitlements
# row. Copy the URL and anon key from cratecloud-v3/.env (they are the
# MAIN_VITE_ prefixed pair there) or from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ SERVER ONLY. Bypasses RLS entirely. This is what lets the Stripe webhook
# write `plan` — and it is why the webhook lives here and not in the Electron
# app. Never prefix it NEXT_PUBLIC_, never paste it into cratecloud-v3/.env.
#
# On Vercel, scope the LIVE value to Production only. Preview deployments
# receive their environment too, and a preview branch holding the live
# service-role key is a real exposure surface.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────────
# Test keys (sk_test_…) locally and on Preview; live keys on Production only.
STRIPE_SECRET_KEY=

# The signing secret for ONE endpoint. There are three different values in
# play and mixing them up is the most common way this breaks:
#   - local:      printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#   - test mode:  the dashboard endpoint you create against the preview URL
#   - live mode:  the dashboard endpoint you create against deepcrated.com
STRIPE_WEBHOOK_SECRET=

# Recurring price ids (price_…, NOT prod_…). The tier key the browser sends
# is mapped to these server-side — see PRICE_ENV in lib/stripe.ts — so the
# client can never name a price of its own.
STRIPE_PRICE_SYNC=
STRIPE_PRICE_LIBRARY=
STRIPE_PRICE_TOURING=

# ─── This site ────────────────────────────────────────────────────────────
# Absolute, no trailing slash. Stripe's success_url / cancel_url / return_url
# are built from it. VERCEL_URL is used as a fallback, but on a production
# deployment that is the generated hostname rather than the custom domain —
# so set this explicitly in Production or buyers get redirected somewhere
# they have never seen.
#   local:      http://localhost:3000
#   production: https://deepcrated.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible). Account ID is in the R2 dashboard sidebar;
# create an API token under R2 > Manage API Tokens (Object Read & Write,
# scoped to the bucket) to get the access key id + secret.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Address for the "notify me" mailto on /cloud-mobile and the /support contact.
NEXT_PUBLIC_CONTACT_EMAIL=

# Loops (https://app.loops.so/settings?page=api). Server-only: never prefix it
# NEXT_PUBLIC_. Used by /api/waitlist to create the contact; unset => the signup
# is still saved in Supabase and the Loops step is skipped with a warning.
LOOPS_API_KEY=
